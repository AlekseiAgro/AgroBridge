PORT=3001
DATABASE_URL=postgresql://agrobridge:agrobridge@localhost:5432/agrobridge?schema=public
WEB_ORIGIN=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:3000
REDIS_URL=redis://localhost:6379
# Required in production: must not stay as change-me-in-production
JWT_SECRET=change-me-in-production
JWT_EXPIRES_SECONDS=604800

# --- Abuse protection (see docs/RATE_LIMITING.md) ---
# Which X-Forwarded-For entries the API believes. Wrong values break IP-based limits.
# Accepts a hop count (0 = no proxy) or a list of trusted proxies.
# Defaults to loopback,linklocal,uniquelocal in production and 0 elsewhere.
# TRUST_PROXY=0
# Optional dedicated secret for rate-limit key hashing; falls back to JWT_SECRET.
# RATE_LIMIT_KEY_SECRET=
# Overrides for the built-in security defaults; every value is validated at boot.
# RATE_LIMIT_LOGIN_MAX=5
# RATE_LIMIT_LOGIN_WINDOW_SEC=900
# RATE_LIMIT_LOGIN_IP_MAX=30
# RATE_LIMIT_REGISTER_IP_MAX=10
# RATE_LIMIT_CODE_SEND_MAX=3
# RATE_LIMIT_CODE_SEND_COOLDOWN_SEC=60
# RATE_LIMIT_CODE_SEND_IP_MAX=10
# RATE_LIMIT_CODE_CONFIRM_MAX=10
# RATE_LIMIT_CODE_CONFIRM_IP_MAX=30
# RATE_LIMIT_CODE_MAX_ATTEMPTS=5
# RATE_LIMIT_SUPPORT_IP_MAX=5
# RATE_LIMIT_SUPPORT_EMAIL_MAX=10
# Password reset (see docs/RATE_LIMITING.md). Defaults are safe for production.
# PASSWORD_RESET_TTL_SEC=1800
# RATE_LIMIT_PASSWORD_RESET_MAX=3
# RATE_LIMIT_PASSWORD_RESET_WINDOW_SEC=3600
# RATE_LIMIT_PASSWORD_RESET_IP_MAX=10
# RATE_LIMIT_PASSWORD_RESET_COOLDOWN_SEC=60
# RATE_LIMIT_PASSWORD_RESET_CONSUME_MAX=30
# RATE_LIMIT_PASSWORD_CHANGE_MAX=5

# Email: console (default, logs only), resend (HTTPS API), or smtp (legacy)
# Local/dev/test: MAIL_DRIVER=console (RESEND_API_KEY / SMTP_* may be omitted)
# Production (NODE_ENV=production): MAIL_DRIVER=resend + RESEND_API_KEY + MAIL_FROM.
# Console is refused unless MAIL_ALLOW_CONSOLE=true (staging override). Incomplete
# resend/smtp config fails startup; there is no silent fallback to console.
# RESEND_API_KEY is server-side only — never NEXT_PUBLIC_* or a browser bundle.
MAIL_DRIVER=console
# MAIL_ALLOW_CONSOLE=true
MAIL_FROM="AgroBridge <noreply@agrobridge.local>"
SUPPORT_EMAIL=gabo.m0619@gmail.com
# RESEND_API_KEY=
# SMTP remains supported for local/legacy use. Unused when MAIL_DRIVER=resend.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# Port 465 implies SMTPS; 587 uses STARTTLS. Override with SMTP_SECURE=true|false if needed.
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Chat translation: mock (default) or openai
TRANSLATION_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_TRANSLATION_MODEL=gpt-4o-mini

# Google Places Autocomplete for product origin (settlements only).
# Enable Places API (New) on the Google Cloud project. Leave empty to disable suggestions.
# GOOGLE_MAPS_API_KEY=

# Admin seed: pnpm --filter @agrobridge/api db:seed
ADMIN_EMAIL=admin@agrobridge.local
ADMIN_PASSWORD=ChangeMeAdmin1
ADMIN_DISPLAY_NAME=AgroBridge Admin

# Product image storage: local (dev default) or s3 (AWS S3 / Cloudflare R2).
# When STORAGE_DRIVER=s3:
#   public media → S3_PUBLIC_BUCKET (or legacy S3_BUCKET) + STORAGE_PUBLIC_BASE_URL/{key}
#   private farm documents → S3_PRIVATE_BUCKET (no public URL, no public custom domain)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=uploads
API_PUBLIC_URL=http://localhost:3001
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
# S3_PUBLIC_BUCKET=
# S3_PRIVATE_BUCKET=
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Production checklist: see docs/DEPLOY.md and .env.production.example

