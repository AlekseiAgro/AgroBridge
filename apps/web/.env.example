# Local: API origin including /api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Production: public API URL (baked into the Next.js client bundle at build time).
# Current target: https://api.agrobridge.ge/api — change + rebuild web when moving domains.
# See docs/DOMAIN.md

# Server-only: address the Next.js server itself uses to reach the API. Must not be a
# NEXT_PUBLIC_ variable — it never belongs in the browser bundle. Optional locally
# (falls back to NEXT_PUBLIC_API_URL); required in production, where routing server-side
# calls through the public hostname costs per-visitor rate limiting.
# compose:  API_INTERNAL_URL=http://api:3001/api
# Railway:  API_INTERNAL_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:8080/api
#           (do not set PORT on the api service; Railway injects 8080)
