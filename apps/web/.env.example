# Local: API origin including /api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Production: public API URL (baked into the Next.js client bundle at build time).
# Production: https://api.agrobridge.ge/api — rebuild web whenever this changes.
# Cutover values: ./scripts/domain-cutover.sh agrobridge.ge
# See docs/DOMAIN.md
