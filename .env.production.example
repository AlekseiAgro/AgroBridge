# Copy to `.env.production` and fill secrets before deploy.
# Domain is NOT hardcoded in app code — change these URLs later to move hosts.

# --- Public URLs (agrobrid.ge now; swap later without code changes) ---
# Recommended: web on apex, API on subdomain (avoids clashing with Next.js /api routes).
WEB_ORIGIN=https://agrobrid.ge
WEB_PUBLIC_URL=https://agrobrid.ge
API_PUBLIC_URL=https://api.agrobrid.ge
NEXT_PUBLIC_API_URL=https://api.agrobrid.ge/api

# Temporary dual-domain cutover (optional):
# WEB_ORIGIN=https://agrobrid.ge,https://new-domain.example

# Host port mappings (optional; reverse proxy usually targets these)
WEB_HOST_PORT=3000
API_HOST_PORT=3001

# --- Database ---
POSTGRES_USER=agrobridge
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=agrobridge

# --- Auth (required in production) ---
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_SECONDS=604800

# --- Abuse protection (see docs/RATE_LIMITING.md) ---
# MUST match the number of reverse proxies in front of the API, or IP-based limits either
# lump every visitor into one bucket or believe a forged X-Forwarded-For.
#   1 = Caddy (deploy/Caddyfile) or the Railway edge only  <- default in production
#   2 = Cloudflare proxying (orange cloud) in front of Caddy
TRUST_PROXY_HOPS=1
# Limits fall back to safe defaults; uncomment only to tune. See docs/RATE_LIMITING.md.
# RATE_LIMIT_LOGIN_MAX=5
# RATE_LIMIT_CODE_SEND_MAX=3
# RATE_LIMIT_CODE_MAX_ATTEMPTS=5
# RATE_LIMIT_SUPPORT_IP_MAX=5

# --- Support inbox ---
SUPPORT_EMAIL=gabo.m0619@gmail.com

# --- Email ---
# Set MAIL_DRIVER=smtp for launch: the console driver only logs messages, so verification
# emails are never delivered (their bodies are also redacted from production logs).
MAIL_DRIVER=console
MAIL_FROM=AgroBridge <noreply@agrobrid.ge>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# --- Chat translation ---
TRANSLATION_PROVIDER=mock
# OPENAI_API_KEY=

# --- Google Places (product origin autocomplete; settlements only) ---
# GOOGLE_MAPS_API_KEY=

# --- Media storage ---
STORAGE_DRIVER=local
# Prefer S3/R2 before a domain move so image URLs stay stable:
# STORAGE_DRIVER=s3
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Optional seed admin ---
ADMIN_EMAIL=admin@agrobrid.ge
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_DISPLAY_NAME=AgroBridge Admin
