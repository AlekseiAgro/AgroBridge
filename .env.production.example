# Copy to `.env.production` and fill secrets before deploy.
# Domain is NOT hardcoded in app code — change these URLs to move hosts.
# Cutover agrobrid.ge → agrobridge.ge: ./scripts/domain-cutover.sh agrobridge.ge

# --- Public URLs (production target: agrobridge.ge) ---
# Recommended: web on apex, API on subdomain (avoids clashing with Next.js /api routes).
WEB_ORIGIN=https://agrobridge.ge
WEB_PUBLIC_URL=https://agrobridge.ge
API_PUBLIC_URL=https://api.agrobridge.ge
NEXT_PUBLIC_API_URL=https://api.agrobridge.ge/api

# VPS Caddy hostnames (deploy/Caddyfile). Defaults match the URLs above if unset.
# WEB_HOST=agrobridge.ge
# API_HOST=api.agrobridge.ge

# Temporary dual-domain cutover from agrobrid.ge (spaces after commas are fine):
# WEB_ORIGIN=https://agrobrid.ge,https://agrobridge.ge
# OLD_WEB_HOST=agrobrid.ge
# OLD_API_HOST=api.agrobrid.ge

# Host port mappings (optional; reverse proxy usually targets these)
WEB_HOST_PORT=3000
API_HOST_PORT=3001

# --- Database ---
POSTGRES_USER=agrobridge
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=agrobridge

# --- Auth (required in production) ---
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_SECONDS=604800

# --- Support inbox ---
SUPPORT_EMAIL=gabo.m0619@gmail.com

# --- Email ---
MAIL_DRIVER=console
MAIL_FROM=AgroBridge <noreply@agrobridge.ge>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# --- Chat translation ---
TRANSLATION_PROVIDER=mock
# OPENAI_API_KEY=

# --- Google Places (product origin autocomplete; settlements only) ---
# GOOGLE_MAPS_API_KEY=

# --- Media storage ---
STORAGE_DRIVER=local
# Prefer S3/R2 before a domain move so image URLs stay stable:
# STORAGE_DRIVER=s3
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Optional seed admin ---
ADMIN_EMAIL=admin@agrobridge.ge
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_DISPLAY_NAME=AgroBridge Admin
