# Copy to `.env.production` and fill secrets before deploy.
# Domain is NOT hardcoded in app code — change these URLs to move hosts.
# Print a ready-to-paste block: ./scripts/domain-cutover.sh new-domain.example

# --- Public URLs (current production: agrobrid.ge) ---
# Recommended: web on apex, API on subdomain (avoids clashing with Next.js /api routes).
WEB_ORIGIN=https://agrobrid.ge
WEB_PUBLIC_URL=https://agrobrid.ge
API_PUBLIC_URL=https://api.agrobrid.ge
NEXT_PUBLIC_API_URL=https://api.agrobrid.ge/api

# VPS Caddy hostnames (deploy/Caddyfile). Defaults match the URLs above if unset.
# WEB_HOST=agrobrid.ge
# API_HOST=api.agrobrid.ge

# Temporary dual-domain cutover (optional, spaces after commas are fine):
# WEB_ORIGIN=https://agrobrid.ge,https://new-domain.example
# WEB_PUBLIC_URL=https://new-domain.example
# API_PUBLIC_URL=https://api.new-domain.example
# NEXT_PUBLIC_API_URL=https://api.new-domain.example/api
# WEB_HOST=new-domain.example
# API_HOST=api.new-domain.example
# OLD_WEB_HOST=agrobrid.ge
# OLD_API_HOST=api.agrobrid.ge

# Host port mappings (optional; reverse proxy usually targets these)
WEB_HOST_PORT=3000
API_HOST_PORT=3001

# --- Database ---
POSTGRES_USER=agrobridge
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=agrobridge

# --- Auth (required in production) ---
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_SECONDS=604800

# --- Support inbox ---
SUPPORT_EMAIL=gabo.m0619@gmail.com

# --- Email ---
MAIL_DRIVER=console
MAIL_FROM=AgroBridge <noreply@agrobrid.ge>
# During a domain move, switch MAIL_FROM to noreply@new-domain.example (see docs/DOMAIN.md).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# --- Chat translation ---
TRANSLATION_PROVIDER=mock
# OPENAI_API_KEY=

# --- Google Places (product origin autocomplete; settlements only) ---
# GOOGLE_MAPS_API_KEY=

# --- Media storage ---
STORAGE_DRIVER=local
# Prefer S3/R2 before a domain move so image URLs stay stable:
# STORAGE_DRIVER=s3
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Optional seed admin ---
ADMIN_EMAIL=admin@agrobrid.ge
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_DISPLAY_NAME=AgroBridge Admin
