# Copy to `.env.production` and fill in real values before:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# --- Public URLs (must match how users reach the app; use https in real deploys) ---
WEB_ORIGIN=https://app.example.com
WEB_PUBLIC_URL=https://app.example.com
API_PUBLIC_URL=https://api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com/api

# Host port mappings (optional)
WEB_HOST_PORT=3000
API_HOST_PORT=3001

# --- Database ---
POSTGRES_USER=agrobridge
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=agrobridge

# --- Auth (required in production) ---
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_SECONDS=604800

# --- Support inbox ---
SUPPORT_EMAIL=gabo.m0619@gmail.com

# --- Email ---
# console = log only; smtp = real delivery
MAIL_DRIVER=console
MAIL_FROM=AgroBridge <noreply@example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# --- Chat translation ---
TRANSLATION_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_TRANSLATION_MODEL=gpt-4o-mini

# --- Media storage ---
# local = container volume; s3 = AWS S3 / Cloudflare R2
STORAGE_DRIVER=local
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Optional seed admin (used only when you run db:seed manually) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_DISPLAY_NAME=AgroBridge Admin
