# Copy to `.env.production` and fill secrets before deploy.
# Domain is NOT hardcoded in app code — change these URLs later to move hosts.

# --- Public URLs (agrobrid.ge now; swap later without code changes) ---
# Recommended: web on apex, API on subdomain (avoids clashing with Next.js /api routes).
WEB_ORIGIN=https://agrobrid.ge
WEB_PUBLIC_URL=https://agrobrid.ge
API_PUBLIC_URL=https://api.agrobrid.ge
NEXT_PUBLIC_API_URL=https://api.agrobrid.ge/api

# Private address the Next.js server uses to reach the API (never sent to the browser).
# Keeping server-side calls off the public hostname is what lets the API tell visitors
# apart for rate limiting — see docs/RATE_LIMITING.md.
#   compose: http://api:3001/api
#   Railway: http://${{api.RAILWAY_PRIVATE_DOMAIN}}:8080/api
#            (do not set PORT on the api service; Railway injects 8080)
API_INTERNAL_URL=http://api:3001/api

# Temporary dual-domain cutover (optional):
# WEB_ORIGIN=https://agrobrid.ge,https://new-domain.example

# Host port mappings (optional; reverse proxy usually targets these)
WEB_HOST_PORT=3000
API_HOST_PORT=3001

# --- Database ---
POSTGRES_USER=agrobridge
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=agrobridge

# --- Auth (required in production) ---
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_SECONDS=604800

# --- Abuse protection (see docs/RATE_LIMITING.md) ---
# Controls which X-Forwarded-For entries the API believes. Get this wrong and IP-based
# limits either lump every visitor into one bucket or believe a forged header.
#   default = loopback + private ranges, which is what the Next.js BFF reaches us from once
#             API_INTERNAL_URL is set (compose bridge, Railway fd12::/16 and 10.0.0.0/8)
#   values matching every address (0.0.0.0/0, ::/0) are rejected at boot
# TRUST_PROXY=loopback,linklocal,uniquelocal
# Limits fall back to safe defaults; uncomment only to tune. See docs/RATE_LIMITING.md.
# RATE_LIMIT_LOGIN_MAX=5
# RATE_LIMIT_CODE_SEND_MAX=3
# RATE_LIMIT_CODE_MAX_ATTEMPTS=5
# RATE_LIMIT_SUPPORT_IP_MAX=5
# PASSWORD_RESET_TTL_SEC=1800
# RATE_LIMIT_PASSWORD_RESET_MAX=3
# RATE_LIMIT_PASSWORD_RESET_IP_MAX=10
# RATE_LIMIT_PASSWORD_RESET_CONSUME_MAX=30
# RATE_LIMIT_PASSWORD_CHANGE_MAX=5

# --- Support inbox ---
SUPPORT_EMAIL=gabo.m0619@gmail.com

# --- Email ---
# NODE_ENV=production refuses MAIL_DRIVER=console (no silent logged-only mail).
# Staging that must keep console: MAIL_ALLOW_CONSOLE=true.
# Production delivery: MAIL_DRIVER=smtp plus host, port, user, password, from.
# Hostname only — never user:password@host.
MAIL_DRIVER=smtp
MAIL_FROM=AgroBridge <noreply@agrobrid.ge>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
# MAIL_ALLOW_CONSOLE=true

# --- Chat translation ---
TRANSLATION_PROVIDER=mock
# OPENAI_API_KEY=

# --- Google Places (product origin autocomplete; settlements only) ---
# GOOGLE_MAPS_API_KEY=

# --- Media storage ---
STORAGE_DRIVER=local
# Prefer S3/R2 before a domain move so image URLs stay stable:
# STORAGE_DRIVER=s3
# STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Optional seed admin ---
ADMIN_EMAIL=admin@agrobrid.ge
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_DISPLAY_NAME=AgroBridge Admin
