# Caddy reverse proxy for AgroBridge (VPS).
# Hostnames come from env so a domain move does not require editing this file:
#
#   export WEB_HOST=agrobridge.ge
#   export API_HOST=api.agrobridge.ge
#   caddy run --config deploy/Caddyfile --adapter caddyfile
#
# Defaults are the current production hosts.
# Optional 301 from another hostname: see deploy/Caddyfile.redirects

{$WEB_HOST:agrobridge.ge} {
	encode gzip
	reverse_proxy 127.0.0.1:3000
}

{$API_HOST:api.agrobridge.ge} {
	encode gzip
	reverse_proxy 127.0.0.1:3001
}
